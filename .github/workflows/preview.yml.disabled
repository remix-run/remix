# Package builds run without publishing credentials. Releases and cleanup use
# REMIX_PREVIEWS_PAT, scoped to REMIX_PREVIEWS_REPOSITORY (default remix-run/previews).
# The destination must be public, initialized, and have release immutability disabled.
name: Preview Build

on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, closed]
  schedule:
    - cron: '23 4 * * *'
  workflow_dispatch:
    inputs:
      baseBranch:
        description: Source branch or SHA
        required: true
      previewName:
        description: Experimental preview name (letters, numbers, dots, underscores, hyphens)
        required: true

permissions:
  contents: read

env:
  REMIX_PREVIEWS_REPOSITORY: ${{ vars.REMIX_PREVIEWS_REPOSITORY || 'remix-run/previews' }}

jobs:
  build:
    if: >-
      github.repository == 'remix-run/remix' &&
      (github.event_name == 'push' || github.event_name == 'workflow_dispatch' ||
      (github.event_name == 'pull_request' && github.event.pull_request.state == 'open' &&
      github.event.pull_request.head.repo.full_name == github.repository))
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: source
    outputs:
      channel: ${{ steps.metadata.outputs.channel }}
    env:
      PREVIEW_CHANNEL: ${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.pull_request.number) || github.event_name == 'push' && 'main' || format('experimental-{0}', inputs.previewName) }}
    steps:
      # Keep tooling separate so PRs and experimental refs can predate this workflow.
      - name: Checkout preview tooling
        uses: actions/checkout@v6
        with:
          path: tools
          persist-credentials: false
      - name: Checkout source
        uses: actions/checkout@v6
        with:
          ref: ${{ github.event.pull_request.head.sha || inputs.baseBranch || github.sha }}
          path: source
          persist-credentials: false
      - uses: pnpm/action-setup@v6
        with:
          package_json_file: source/package.json
      - uses: actions/setup-node@v6
        with:
          node-version-file: tools/package.json
          package-manager-cache: false
      - name: Get pnpm store path
        id: pnpm-store
        continue-on-error: true
        run: echo "path=$(pnpm store path --silent)" >> "$GITHUB_OUTPUT"
      - uses: actions/cache@v5
        if: steps.pnpm-store.outputs.path != ''
        continue-on-error: true
        with:
          path: ${{ steps.pnpm-store.outputs.path }}
          key: pnpm-store-${{ runner.os }}-${{ hashFiles('source/pnpm-lock.yaml') }}
      - run: pnpm install --frozen-lockfile
      - name: Build tarballs
        run: node "$GITHUB_WORKSPACE/tools/scripts/preview.ts" build "$PREVIEW_CHANNEL" --output "$RUNNER_TEMP/preview"
      - name: Record channel
        id: metadata
        run: printf 'channel=%s\n' "$PREVIEW_CHANNEL" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@v7
        with:
          name: preview-${{ github.run_id }}
          path: ${{ runner.temp }}/preview/*
          if-no-files-found: error
          overwrite: true
          retention-days: 3
          compression-level: 0

  publish:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    concurrency:
      group: preview-${{ needs.build.outputs.channel }}
      queue: max
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version-file: package.json
          package-manager-cache: false
      - uses: actions/download-artifact@v8
        with:
          name: preview-${{ github.run_id }}
          path: .preview
      - name: Publish release assets
        id: publish
        env:
          REMIX_PREVIEWS_PAT: ${{ secrets.REMIX_PREVIEWS_PAT }}
          GITHUB_TOKEN: ${{ github.token }}
        run: node scripts/preview.ts publish
      - name: Update PR installation instructions
        if: github.event_name == 'pull_request' && steps.publish.outputs.published == 'true'
        env:
          GITHUB_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: node scripts/preview-pr.ts comment "$PR_NUMBER"

  cleanup:
    if: >-
      github.repository == 'remix-run/remix' &&
      (github.event_name == 'schedule' || (github.event_name == 'pull_request' &&
      github.event.pull_request.merged == true &&
      github.event.pull_request.head.repo.full_name == github.repository))
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    concurrency:
      group: preview-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.pull_request.number) || 'main' }}
      queue: max
    env:
      PREVIEW_CHANNEL: ${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.pull_request.number) || 'main' }}
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version-file: package.json
          package-manager-cache: false
      - name: Delete expired releases and tags
        env:
          REMIX_PREVIEWS_PAT: ${{ secrets.REMIX_PREVIEWS_PAT }}
          GITHUB_TOKEN: ${{ github.token }}
        run: node scripts/preview.ts cleanup "$PREVIEW_CHANNEL"
      - name: Update merged PR preview comment
        if: github.event_name == 'pull_request'
        env:
          GITHUB_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: node scripts/preview-pr.ts cleanup "$PR_NUMBER"
