# Backports https://github.com/microsoft/playwright/pull/43605, which disables Chromium
# TCP port randomization on Windows to avoid intermittent ERR_NO_BUFFER_SPACE failures
# during loopback requests. Updates both bundled copies of the default Chromium feature list.
# Remove when upgrading to a stable Playwright release that includes this fix.

diff --git a/lib/coreBundle.js b/lib/coreBundle.js
--- a/lib/coreBundle.js
+++ b/lib/coreBundle.js
@@ -34842,6 +34842,8 @@
       "Translate",
       // See https://issues.chromium.org/u/1/issues/435410220
       "AutoDeElevate",
+      // Avoids intermittent ERR_NO_BUFFER_SPACE failures on Windows (https://crbug.com/572515601).
+      "TcpPortRandomizationWin",
       // Prevents downloading optimization hints on startup.
       "OptimizationHints",
       // Disables forced sign-in in Edge.
diff --git a/lib/server/electron/loader.js b/lib/server/electron/loader.js
--- a/lib/server/electron/loader.js
+++ b/lib/server/electron/loader.js
@@ -28,6 +28,8 @@
   "Translate",
   // See https://issues.chromium.org/u/1/issues/435410220
   "AutoDeElevate",
+  // Avoids intermittent ERR_NO_BUFFER_SPACE failures on Windows (https://crbug.com/572515601).
+  "TcpPortRandomizationWin",
   // Prevents downloading optimization hints on startup.
   "OptimizationHints",
   // Disables forced sign-in in Edge.
