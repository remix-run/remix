{
  "name": "@remix-run/multiple-import-maps-polyfill",
  "version": "1.0.2",
  "description": "Polyfill for dynamic JavaScript imports that depend on import maps added at runtime",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/multiple-import-maps-polyfill"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/multiple-import-maps-polyfill#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "es-module-lexer": "^2.3.0"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:^",
    "@remix-run/node-fetch-server": "workspace:^",
    "@remix-run/test": "workspace:^",
    "@types/node": "catalog:",
    "esbuild": "^0.27.1",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-browser.ts",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && remix test",
    "test:bun": "bun x --bun remix test --type server",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "remix",
    "browser",
    "import-maps",
    "modules",
    "polyfill"
  ]
}
