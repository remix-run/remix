    "@remix-run/session": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@remix-run/cookie": "https://raw.githubusercontent.com/remix-run/remix/refs/heads/brophdawg11/codex-preview-tarballs-build/tarballs/1b9c1242/cookie.tgz",
