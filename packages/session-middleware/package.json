  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/session-middleware#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
