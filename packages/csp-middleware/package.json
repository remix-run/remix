{
  "name": "@remix-run/csp-middleware",
  "version": "0.0.0",
  "description": "Content Security Policy middleware and request-scoped nonces for Remix",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/csp-middleware"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/csp-middleware#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:^",
    "@remix-run/test": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@remix-run/fetch-router": "remix-run/remix#preview/pr-12098&path:packages/fetch-router",
    "@remix-run/headers": "remix-run/remix#preview/pr-12098&path:packages/headers"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fetch",
    "middleware",
    "csp",
    "nonce"
  ]
}
