{
  "name": "@remix-run/headers",
  "version": "1.1.0",
  "description": "A toolkit for working with HTTP headers in JavaScript",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/headers"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/headers#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./accept": "./src/accept.ts",
    "./accept-encoding": "./src/accept-encoding.ts",
    "./accept-language": "./src/accept-language.ts",
    "./cache-control": "./src/cache-control.ts",
    "./content-disposition": "./src/content-disposition.ts",
    "./content-range": "./src/content-range.ts",
    "./content-security-policy": "./src/content-security-policy.ts",
    "./content-type": "./src/content-type.ts",
    "./cookie": "./src/cookie.ts",
    "./if-match": "./src/if-match.ts",
    "./if-none-match": "./src/if-none-match.ts",
    "./if-range": "./src/if-range.ts",
    "./range": "./src/range.ts",
    "./raw-headers": "./src/raw-headers.ts",
    "./set-cookie": "./src/set-cookie.ts",
    "./vary": "./src/vary.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./accept": {
        "types": "./dist/accept.d.ts",
        "default": "./dist/accept.js"
      },
      "./accept-encoding": {
        "types": "./dist/accept-encoding.d.ts",
        "default": "./dist/accept-encoding.js"
      },
      "./accept-language": {
        "types": "./dist/accept-language.d.ts",
        "default": "./dist/accept-language.js"
      },
      "./cache-control": {
        "types": "./dist/cache-control.d.ts",
        "default": "./dist/cache-control.js"
      },
      "./content-disposition": {
        "types": "./dist/content-disposition.d.ts",
        "default": "./dist/content-disposition.js"
      },
      "./content-range": {
        "types": "./dist/content-range.d.ts",
        "default": "./dist/content-range.js"
      },
      "./content-security-policy": {
        "types": "./dist/content-security-policy.d.ts",
        "default": "./dist/content-security-policy.js"
      },
      "./content-type": {
        "types": "./dist/content-type.d.ts",
        "default": "./dist/content-type.js"
      },
      "./cookie": {
        "types": "./dist/cookie.d.ts",
        "default": "./dist/cookie.js"
      },
      "./if-match": {
        "types": "./dist/if-match.d.ts",
        "default": "./dist/if-match.js"
      },
      "./if-none-match": {
        "types": "./dist/if-none-match.d.ts",
        "default": "./dist/if-none-match.js"
      },
      "./if-range": {
        "types": "./dist/if-range.d.ts",
        "default": "./dist/if-range.js"
      },
      "./range": {
        "types": "./dist/range.d.ts",
        "default": "./dist/range.js"
      },
      "./raw-headers": {
        "types": "./dist/raw-headers.d.ts",
        "default": "./dist/raw-headers.js"
      },
      "./set-cookie": {
        "types": "./dist/set-cookie.d.ts",
        "default": "./dist/set-cookie.js"
      },
      "./vary": {
        "types": "./dist/vary.d.ts",
        "default": "./dist/vary.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fetch",
    "http",
    "header",
    "headers",
    "http-headers",
    "request-headers",
    "response-headers",
    "content-negotiation",
    "cookies",
    "set-cookie",
    "cache-control",
    "content-type",
    "accept",
    "accept-encoding",
    "accept-language",
    "content-disposition",
    "if-none-match",
    "etag",
    "user-agent",
    "host",
    "last-modified"
  ]
}
