{
  "name": "@remix-run/spa",
  "version": "0.0.0",
  "description": "Client-rendered application routing for Remix",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/spa"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/spa#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test*.ts",
    "!src/**/*.test*.tsx"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:^",
    "@remix-run/test": "workspace:^",
    "@types/dom-navigation": "^1.0.7",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@remix-run/fetch-router": "remix-run/remix#preview/pr-11687&path:packages/fetch-router",
    "@remix-run/render-middleware": "remix-run/remix#preview/pr-11687&path:packages/render-middleware",
    "@remix-run/ui": "remix-run/remix#preview/pr-11687&path:packages/ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "remix",
    "spa",
    "router",
    "client",
    "browser"
  ]
}
