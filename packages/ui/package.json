{
  "name": "@remix-run/ui",
  "version": "0.12.1",
  "description": "Headless, accessible UI primitives and animation utilities for Remix components",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/ui#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!dist/**/demos",
    "!src/**/demos",
    "!src/**/*.demo.ts",
    "!src/**/*.demo.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "default": "./dist/accordion.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "default": "./dist/anchor.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "default": "./dist/animation.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "default": "./dist/combobox.js"
    },
    "./listbox": {
      "types": "./dist/listbox.d.ts",
      "default": "./dist/listbox.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "default": "./dist/menu.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "default": "./dist/popover.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "default": "./dist/toggle.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@remix-run/component": "remix-run/remix#preview/pr-11979&path:packages/component"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/dom-navigation": "^1.0.7",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "lint": "pnpm -w exec oxlint packages/ui --max-warnings=0",
    "lint:fix": "pnpm -w exec oxlint packages/ui --fix --max-warnings=0",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:coverage": "remix test --coverage",
    "test:watch": "remix test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "remix",
    "ui",
    "headless",
    "accessible",
    "primitives",
    "animation"
  ]
}
