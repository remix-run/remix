{
  "name": "@remix-run/render-middleware",
  "version": "1.0.1",
  "description": "Conventional Remix component and custom request-scoped render middleware",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/render-middleware"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/render-middleware#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/fetch-router": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@remix-run/assets": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/assets.tgz",
    "@remix-run/component": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/component.tgz",
    "@remix-run/fetch-router": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/fetch-router.tgz",
    "@remix-run/response": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/response.tgz"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fetch",
    "router",
    "middleware",
    "render",
    "renderer",
    "response"
  ]
}
