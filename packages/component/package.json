{
  "name": "@remix-run/component",
  "version": "0.7.0",
  "description": "Component runtime with server rendering and browser hydration",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/component"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/component#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!dist/**/demos",
    "!src/**/demos",
    "!src/**/*.demo.ts",
    "!src/**/*.demo.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./animation": {
      "types": "./src/animation.ts",
      "default": "./src/animation.ts"
    },
    "./dev/refresh": {
      "types": "./src/dev/refresh.ts",
      "default": "./src/dev/refresh.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "default": "./src/test.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./animation": {
        "types": "./dist/animation.d.ts",
        "default": "./dist/animation.js"
      },
      "./dev/refresh": {
        "types": "./dist/dev/refresh.d.ts",
        "default": "./dist/dev/refresh.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./test": {
        "types": "./dist/test.d.ts",
        "default": "./dist/test.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@types/dom-navigation": "^1.0.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "lint": "pnpm -w exec oxlint packages/component --max-warnings=0",
    "lint:fix": "pnpm -w exec oxlint packages/component --fix --max-warnings=0",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:coverage": "remix test --coverage",
    "test:watch": "remix test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "remix",
    "component",
    "runtime",
    "rendering",
    "mixins"
  ]
}
