{
  "name": "@remix-run/fs",
  "version": "1.0.0",
  "description": "Filesystem utilities using the Web File API",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/fs"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/fs#readme",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@remix-run/lazy-file": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/lazy-file.tgz",
    "@remix-run/mime": "https://raw.githubusercontent.com/remix-run/remix/preview/pr-12126/t/2581ea3a/mime.tgz"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix test",
    "test:bun": "bun x --bun remix test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "file",
    "filesystem",
    "fs"
  ]
}
