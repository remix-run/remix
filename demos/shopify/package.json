{
  "name": "shopify-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "workspace:*"
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:^",
    "@remix-run/test": "workspace:^",
    "@types/node": "catalog:",
    "node-html-parser": "^7.0.2",
    "typescript": "catalog:",
    "wrangler": "^4.90.1"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "dev:worker": "pnpm prerender && wrangler dev",
    "deploy": "pnpm prerender && wrangler deploy",
    "deploy:check": "pnpm prerender && wrangler deploy --dry-run",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "prerender": "NODE_ENV=production node --import remix/node-tsx scripts/prerender.ts",
    "preview": "node --import remix/node-tsx scripts/preview.ts",
    "test": "remix test",
    "typecheck": "tsc --noEmit"
  }
}
