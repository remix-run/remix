{
  "$schema": "https://raw.githubusercontent.com/remix-run/remix/main/packages/cli/schema/remix.json",
  "assets": {
    "rootDir": "../..",
    "basePath": "/assets",
    "mounts": {
      "app": "demos/timeboxer/app",
      "packages": "packages"
    },
    "allowFiles": ["demos/timeboxer/app/routes.ts", "demos/timeboxer/app/**/public/**"],
    "allowPackages": ["remix"],
    "denyFiles": ["demos/timeboxer/app/**/*.test.*"]
  },
  "db": {
    "adapter": {
      "type": "sqlite",
      "filename": {
        "env": "DATABASE_URL",
        "default": "./db/timebox.sqlite"
      },
      "foreignKeys": true
    },
    "migrations": {
      "directory": "./db/migrations"
    }
  }
}
